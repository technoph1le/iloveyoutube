# Public address of the site (canonical URLs, sitemap, social previews).
NEXT_PUBLIC_SITE_URL=https://www.iloveyoutube.dev

# Where the Express API runs; /api/* is proxied there.
# Local: http://localhost:4000. Production: the backend's public Railway URL,
# e.g. https://iloveyoutube-backend.up.railway.app (no trailing slash).
BACKEND_URL=http://localhost:4000
