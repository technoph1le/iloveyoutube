PORT=4000

# YouTube Data API v3 key: console.cloud.google.com -> enable "YouTube Data API v3"
# -> Credentials -> Create API key. Restrict it to the YouTube Data API.
YOUTUBE_API_KEY=
# Country whose trending videos fill the thumbnail previewer feed.
YOUTUBE_REGION=US

# Anthropic API key for the description builder's AI features:
# console.anthropic.com -> API Keys. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=
# AI requests allowed per visitor per hour, and for the whole site per day.
AI_HOURLY_LIMIT=10
AI_DAILY_LIMIT=500
